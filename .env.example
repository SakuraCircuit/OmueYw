APP_NAME="HkList"
APP_LOGO="/favicon.ico"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION="no"
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_DATABASE="hklist"
DB_USERNAME="root"
DB_PASSWORD=""

# 邮件服务
MAIL_SWITCH=false
MAIL_HOST="127.0.0.1"
MAIL_PORT=2525
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="HkList"
MAIL_TO_ADDRESS=""
MAIL_TO_NAME=""

# hklist general 配置项
HKLIST_ADMIN_PASSWORD="admin"
HKLIST_PARSE_PASSWORD="admin"
HKLIST_SHOW_HERO=false
HKLIST_SHOW_ANNOUNCE=true
HKLIST_ANNOUNCE=""
HKLIST_CUSTOM_SCRIPT=""
HKLIST_CUSTOM_BUTTON=""
HKLIST_DISABLE_CHECK_RAND=true

# hklist limit 配置项
HKLIST_MAX_ONCE=5
HKLIST_MIN_SINGLE_FILESIZE=0
HKLIST_MAX_SINGLE_FILESIZE=53687091200
HKLIST_MAX_ALL_FILESIZE=536870912000
HKLIST_MAX_DOWNLOAD_DAILY_PRE_ACCOUNT=0
HKLIST_LIMIT_CN=false
HKLIST_LIMIT_PROV=false

# hklist parse 配置项
HKLIST_ALLOW_FOLDER=false
HKLIST_DDDDOCR_SERVER=""
HKLIST_TOKEN_PARSE_MODE=1
HKLIST_TOKEN_USER_AGENT="netdisk;P2SP;3.0.20.138"
HKLIST_GUEST_PARSE_MODE=1
HKLIST_GUEST_USER_AGENT="netdisk;P2SP;3.0.20.138"
HKLIST_TOKEN_PROXY_HOST=""
HKLIST_TOKEN_PROXY_PASSWORD=""
HKLIST_GUEST_PROXY_HOST=""
HKLIST_GUEST_PROXY_PASSWORD=""
HKLIST_MOIU_TOKEN=""

# hklist proxy 配置项
HKLIST_PROXY_ENABLE=false
HKLIST_PROXY_HTTP=""
HKLIST_PROXY_HTTPS=""

# 配额限制开关
HKLIST_REMOVE_LIMIT=false
